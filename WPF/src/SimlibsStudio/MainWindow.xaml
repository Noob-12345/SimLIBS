<Window x:Class="SimlibsStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="simLIBS Studio" Height="880" Width="1440" MinHeight="640" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionBtn" TargetType="Button" BasedOn="{StaticResource BtnIcon}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======= 标题栏 ======= -->
        <Grid Grid.Row="0" Background="{DynamicResource Bg.Side}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Border Width="26" Height="26" CornerRadius="8"
                        Background="{DynamicResource Gradient.Primary}">
                    <TextBlock Text="◉" Foreground="White" FontSize="14" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="simLIBS Studio" FontSize="15" FontWeight="Bold"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                <Border x:Name="MockBadge" CornerRadius="6" Padding="7,2" Margin="10,0,0,0"
                        Background="{DynamicResource Bg.Card2}"
                        BorderBrush="{DynamicResource Line.Strong}" BorderThickness="1"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="MOCK" FontSize="10.5" FontWeight="Bold"
                               Foreground="{DynamicResource Accent.C}"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                <Button x:Name="AccentBtn" Style="{StaticResource CaptionBtn}"
                        Click="OnAccentButtonClick" ToolTip="主题颜色">
                    <Border x:Name="AccentDot" Width="16" Height="16" CornerRadius="8"
                            Background="{DynamicResource Gradient.Primary}"
                            BorderBrush="{DynamicResource Line.Strong}" BorderThickness="1"/>
                </Button>
                <Button x:Name="ThemeBtn" Style="{StaticResource CaptionBtn}"
                        Click="OnThemeButtonClick" ToolTip="浅色 / 深色 / 跟随系统">
                    <TextBlock x:Name="ThemeIcon" Text="☾" FontSize="14"/>
                </Button>
                <Button x:Name="GitHubBtn" Style="{StaticResource CaptionBtn}"
                        Click="OnGitHubClick" ToolTip="GitHub 仓库 · Noob-12345/SimLIBS">
                    <Path Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                          Width="15" Height="15" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Style="{StaticResource CaptionBtn}" Click="OnMinimize" ToolTip="最小化">
                    <TextBlock Text="—" FontSize="13" Margin="0,-4,0,0"/>
                </Button>
                <Button x:Name="MaxBtn" Style="{StaticResource CaptionBtn}" Click="OnMaximize" ToolTip="最大化">
                    <TextBlock Text="▢" FontSize="11.5" Margin="0,-2,0,0"/>
                </Button>
                <Button Style="{StaticResource CaptionBtn}" Click="OnClose" ToolTip="关闭">
                    <TextBlock Text="✕" FontSize="12.5"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ======= 主体 ======= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 侧边栏 -->
            <Border Grid.Column="0" Background="{DynamicResource Bg.Side}"
                    BorderBrush="{DynamicResource Line.Subtle}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,14">
                        <TextBlock x:Name="SideEngine" Text="引擎启动中…" FontSize="11"
                                   Foreground="{DynamicResource Text.Faint}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SideInterp" Text="" FontSize="10.5" FontFamily="Consolas"
                                   Foreground="{DynamicResource Text.Faint}" TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,18,0,0">
                        <RadioButton x:Name="NavSingle" Style="{StaticResource NavItem}"
                                     GroupName="nav" IsChecked="True" Click="OnNavClick" Tag="single">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                <TextBlock Text="单次模拟" FontSize="13.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavBatch" Style="{StaticResource NavItem}"
                                     GroupName="nav" Click="OnNavClick" Tag="batch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                <TextBlock Text="批量模拟" FontSize="13.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavScan" Style="{StaticResource NavItem}"
                                     GroupName="nav" Click="OnNavClick" Tag="scan">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE914;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                <TextBlock Text="扫描动画" FontSize="13.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavJobs" Style="{StaticResource NavItem}"
                                     GroupName="nav" Click="OnNavClick" Tag="jobs">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                <TextBlock Text="任务记录" FontSize="13.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}"
                                     GroupName="nav" Click="OnNavClick" Tag="settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                <TextBlock Text="设置" FontSize="13.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 内容列 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="26,20,26,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="单次模拟" FontSize="22" FontWeight="Bold"/>
                        <TextBlock x:Name="PageSub" Text="" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Border x:Name="RunningPill" CornerRadius="9" Padding="11,5" Margin="0,0,10,0"
                                Background="{DynamicResource Bg.Card}" Visibility="Collapsed"
                                BorderBrush="{DynamicResource Line.Subtle}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="RunningDot" Width="8" Height="8" Margin="0,0,7,0"
                                         Fill="{DynamicResource State.Running}"/>
                                <TextBlock x:Name="RunningText" Text="0 个任务运行中" FontSize="11.5"
                                           Foreground="{DynamicResource Text.Secondary}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="PageHost" Grid.Row="1" Margin="26,10,26,20"/>
            </Grid>
        </Grid>

        <!-- ======= 状态栏 ======= -->
        <Border Grid.Row="2" Background="{DynamicResource Bg.Side}"
                BorderBrush="{DynamicResource Line.Subtle}" BorderThickness="0,1,0,0"
                Padding="18,7">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="BridgeDot" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{DynamicResource State.Warn}"/>
                    <TextBlock x:Name="BridgeText" Text="正在启动后端…" FontSize="11.5" Margin="8,0,18,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}"/>
                    <TextBlock x:Name="EngineChip" Text="" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Faint}"/>
                </StackPanel>
                <TextBlock x:Name="StatusRight" Text="F2–F6 切换页面 · Ctrl+T 换肤 · 图表：拖框缩放 / 滚轮 / 右键复位"
                           FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text.Faint}"/>
            </Grid>
        </Border>

        <!-- Toast 宿主（右下角浮层） -->
        <Grid Grid.RowSpan="3" IsHitTestVisible="False">
            <StackPanel x:Name="ToastHost" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                        Margin="0,0,20,20"/>
        </Grid>

        <!-- 引擎启动遮罩 -->
        <Border x:Name="BootOverlay" Grid.RowSpan="3" Background="{DynamicResource Bg.Overlay}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="52" Height="52" CornerRadius="16" HorizontalAlignment="Left"
                        Background="{DynamicResource Gradient.Primary}">
                    <TextBlock Text="◉" Foreground="White" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="BootText" Text="simLIBS Studio 正在启动…" FontSize="17" FontWeight="Bold"
                           Margin="0,16,0,4"/>
                <TextBlock x:Name="BootSub" Text="正在初始化 Python 引擎（首次导入约需数秒）"
                           FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
