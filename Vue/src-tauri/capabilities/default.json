{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main desktop window: dialog-selected files and six fixed project/research URLs",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-stat",
    { "identifier": "opener:allow-open-url", "allow": [
      { "url": "https://github.com/Noob-12345/SimLIBS" },
      { "url": "https://physics.nist.gov/PhysRefData/ASD/lines_form.html" },
      { "url": "https://physics.nist.gov/PhysRefData/Handbook/Tables/findinglist.htm" },
      { "url": "https://www.nist.gov/pml/atomic-spectra-database" },
      { "url": "https://stark-b.obspm.fr/" },
      { "url": "https://scholar.google.com/" }
    ] }
  ]
}
