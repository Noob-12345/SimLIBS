<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 强调色主题：翡翠绿 -->

    <Color x:Key="Color.AccentA">#059669</Color>
    <Color x:Key="Color.AccentB">#10b981</Color>
    <Color x:Key="Color.AccentC">#34d399</Color>

    <SolidColorBrush x:Key="Accent.A" Color="#059669"/>
    <SolidColorBrush x:Key="Accent.B" Color="#10b981"/>
    <SolidColorBrush x:Key="Accent.C" Color="#34d399"/>
    <SolidColorBrush x:Key="Accent.Faint" Color="#33059669"/>

    <LinearGradientBrush x:Key="Gradient.Primary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#059669" Offset="0"/>
        <GradientStop Color="#10b981" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient.Title" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#34d399" Offset="0"/>
        <GradientStop Color="#6ee7b7" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient.Area" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#6610b981" Offset="0"/>
        <GradientStop Color="#0010b981" Offset="1"/>
    </LinearGradientBrush>

    <DropShadowEffect x:Key="Fx.Glow" BlurRadius="14" ShadowDepth="0" Opacity="0.55" Color="#10b981"/>

</ResourceDictionary>
