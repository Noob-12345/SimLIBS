<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 强调色主题：熔金琥珀 -->

    <Color x:Key="Color.AccentA">#d97706</Color>
    <Color x:Key="Color.AccentB">#f59e0b</Color>
    <Color x:Key="Color.AccentC">#fbbf24</Color>

    <SolidColorBrush x:Key="Accent.A" Color="#d97706"/>
    <SolidColorBrush x:Key="Accent.B" Color="#f59e0b"/>
    <SolidColorBrush x:Key="Accent.C" Color="#fbbf24"/>
    <SolidColorBrush x:Key="Accent.Faint" Color="#33d97706"/>

    <LinearGradientBrush x:Key="Gradient.Primary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#d97706" Offset="0"/>
        <GradientStop Color="#f59e0b" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient.Title" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#fbbf24" Offset="0"/>
        <GradientStop Color="#fde68a" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient.Area" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66f59e0b" Offset="0"/>
        <GradientStop Color="#00f59e0b" Offset="1"/>
    </LinearGradientBrush>

    <DropShadowEffect x:Key="Fx.Glow" BlurRadius="14" ShadowDepth="0" Opacity="0.55" Color="#f59e0b"/>

</ResourceDictionary>
