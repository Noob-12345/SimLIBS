<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 强调色主题：星舰蓝 -->

    <Color x:Key="Color.AccentA">#2563eb</Color>
    <Color x:Key="Color.AccentB">#3b82f6</Color>
    <Color x:Key="Color.AccentC">#38bdf8</Color>

    <SolidColorBrush x:Key="Accent.A" Color="#2563eb"/>
    <SolidColorBrush x:Key="Accent.B" Color="#3b82f6"/>
    <SolidColorBrush x:Key="Accent.C" Color="#38bdf8"/>
    <SolidColorBrush x:Key="Accent.Faint" Color="#332563eb"/>

    <LinearGradientBrush x:Key="Gradient.Primary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563eb" Offset="0"/>
        <GradientStop Color="#3b82f6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient.Title" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#60a5fa" Offset="0"/>
        <GradientStop Color="#93c5fd" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient.Area" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#663b82f6" Offset="0"/>
        <GradientStop Color="#003b82f6" Offset="1"/>
    </LinearGradientBrush>

    <DropShadowEffect x:Key="Fx.Glow" BlurRadius="14" ShadowDepth="0" Opacity="0.55" Color="#3b82f6"/>

</ResourceDictionary>
