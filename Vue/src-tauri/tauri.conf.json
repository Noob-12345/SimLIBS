{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimLIBS",
  "version": "0.1.0",
  "identifier": "com.simlibs.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SimLIBS",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../backend/simlibs_ui/*.py": "backend/simlibs_ui/",
      "../backend/web/server.py": "backend/web/server.py",
      "../backend/web/backend_api.py": "backend/web/backend_api.py",
      "../backend/web/real_backend.py": "backend/web/real_backend.py",
      "../backend/web/sampling.py": "backend/web/sampling.py",
      "../backend/source/simLIBS/*.py": "backend/source/simLIBS/",
      "../backend/source/simLIBS/data/*.json": "backend/source/simLIBS/data/",
      "../backend/source/simLIBS/py.typed": "backend/source/simLIBS/py.typed",
      "../backend/source/LICENSE*": "backend/source/",
      "../backend/Linedatabase/*.csv": "backend/Linedatabase/",
      "../backend/Linedatabase/*.json": "backend/Linedatabase/",
      "../backend/Linedatabase/*.md": "backend/Linedatabase/",
      "../backend/README.md": "backend/README.md"
    },
    "shortDescription": "SimLIBS 真实光谱工作台",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
